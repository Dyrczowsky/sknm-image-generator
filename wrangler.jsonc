// Cloudflare Worker serwujący statyczny build (dist) pod https://sknm.dyrczowsky.win/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sknm-image-generator",
  "compatibility_date": "2026-11-10",
  // Deploy robi .github/workflows/deploy.yml po zbudowaniu dist.
  "assets": {
    "directory": "./dist",
    // Nieznane ścieżki (np. /poster/wyklad) dostają index.html.
    "not_found_handling": "single-page-application"
  }
}
